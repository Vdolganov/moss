<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="moss-0" name="01 · TAPE → библиотека → SAMPLER"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="resample" value="&lt;b&gt;TAPE · RESAMPLE&lt;/b&gt;&lt;br&gt;Дорожка с SPACE или MASTER&lt;br&gt;Запись исходника на накопитель блоками" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="55" width="440" height="110" /></mxCell><mxCell id="import" value="&lt;b&gt;TAPE · IMPORT&lt;/b&gt;&lt;br&gt;Файл с накопителя устройства&lt;br&gt;Начать с PCM WAV; большой файл читать частями" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="55" width="440" height="110" /></mxCell><mxCell id="librarySource" value="&lt;b&gt;TAPE · LIBRARY&lt;/b&gt;&lt;br&gt;Выбрать существующий материал&lt;br&gt;Оригинал остаётся неизменным" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="55" width="440" height="110" /></mxCell><mxCell id="edit" value="&lt;b&gt;TAPE · EDIT / SLICE&lt;/b&gt;&lt;br&gt;Диапазон · границы слайсов · fade in / out&lt;br&gt;Предпросмотр числа и размеров файлов&lt;br&gt;SAVE SELECTED / SAVE ALL" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="285" width="440" height="130" /></mxCell><mxCell id="assets" value="&lt;b&gt;БИБЛИОТЕКА НА SD&lt;/b&gt;&lt;br&gt;Самостоятельные короткие assets&lt;br&gt;DRONE_01 · DRONE_02 · DUST_03&lt;br&gt;Общий каталог, стабильные ID" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="520" width="440" height="125" /></mxCell><mxCell id="kit" value="&lt;b&gt;VOICE · SAMPLER&lt;/b&gt;&lt;br&gt;Назначить asset на клавишу&lt;br&gt;Свои pitch / start / end / level&lt;br&gt;Один asset можно назначить несколько раз" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="750" width="440" height="130" /></mxCell><mxCell id="tapeScope" value="&lt;b&gt;TAPE ГОТОВИТ МАТЕРИАЛ&lt;/b&gt;&lt;br&gt;Импорт · ресэмплинг · нарезка&lt;br&gt;Создаёт файлы для библиотеки&lt;br&gt;Не меняет ноты и инструмент дорожки" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="520" width="440" height="125" /></mxCell><mxCell id="ram" value="&lt;b&gt;RAM · ОГРАНИЧЕННЫЙ КЭШ&lt;/b&gt;&lt;br&gt;Только нужные уникальные assets&lt;br&gt;Назначения разделяют PCM-буфер&lt;br&gt;Подготовка до наступления шага" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="520" width="440" height="125" /></mxCell><mxCell id="pattern" value="&lt;b&gt;PATTERN · KEY ШАГА&lt;/b&gt;&lt;br&gt;Выбор занятой клавиши SAMPLER&lt;br&gt;Velocity · gate · probability&lt;br&gt;LOCKS: pitch / start / end / level" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="750" width="440" height="130" /></mxCell><mxCell id="distinction" value="&lt;b&gt;ТРИ РАЗНЫХ СОСТОЯНИЯ&lt;/b&gt;&lt;br&gt;Файл есть на SD → файл назначен клавише → файл готов в RAM.&lt;br&gt;Подрезка в SAMPLER меняет воспроизведение назначения. Физическое уменьшение файла выполняется в TAPE.&lt;br&gt;В этой итерации меняются модель и схемы; реального импорта, нарезки и аудиодвижка ещё нет." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="980" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="resample" target="edit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="import" target="edit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="librarySource" target="edit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="Сохранить фрагменты" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="edit" target="assets"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="Выбрать и назначить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="assets" target="kit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="KEY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="kit" target="pattern"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-1" name="02 · Клавиша — назначение сэмпла"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="file" value="&lt;b&gt;ASSET · DRONE_01&lt;/b&gt;&lt;br&gt;Небольшой неизменяемый файл&lt;br&gt;Один PCM-буфер в кэше" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="50" width="440" height="95" /></mxCell><mxCell id="c3" value="&lt;b&gt;C3 · DRONE_01&lt;/b&gt;&lt;br&gt;PITCH 0 · START 0.00 s&lt;br&gt;END 2.00 s · LEVEL 80%" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="250" width="440" height="105" /></mxCell><mxCell id="d3" value="&lt;b&gt;D3 · DRONE_01&lt;/b&gt;&lt;br&gt;PITCH −12 · START 0.40 s&lt;br&gt;END 1.60 s · LEVEL 65%" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="250" width="440" height="105" /></mxCell><mxCell id="g3" value="&lt;b&gt;G3 · DUST_03&lt;/b&gt;&lt;br&gt;Другой asset&lt;br&gt;PITCH +7 · диапазон 0.10–0.70 s" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="250" width="440" height="105" /></mxCell><mxCell id="bank" value="&lt;b&gt;ЧЕТЫРЕ ПАРАМЕТРА КЛАВИШИ&lt;/b&gt;&lt;br&gt;Z: PITCH · X: START · C: END · V: LEVEL&lt;br&gt;Редактирование не меняет исходный файл&lt;br&gt;PLAY MODE: ONE SHOT / GATE / LOOP" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="460" width="440" height="130" /></mxCell><mxCell id="voice" value="&lt;b&gt;VOICE · КАРТА 16 КЛАВИШ&lt;/b&gt;&lt;br&gt;Предложение: C3–D♯4, сетка 4×4&lt;br&gt;D-pad выбирает и пустые клавиши&lt;br&gt;A: назначить, заменить или снять назначение" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="460" width="440" height="130" /></mxCell><mxCell id="step" value="&lt;b&gt;PATTERN · KEY&lt;/b&gt;&lt;br&gt;Только доступные назначенные клавиши&lt;br&gt;C3 → D3 → G3&lt;br&gt;Показывать ноту и имя сэмпла" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="460" width="440" height="130" /></mxCell><mxCell id="lock" value="&lt;b&gt;LOCKS ШАГА&lt;/b&gt;&lt;br&gt;PITCH / START / END / LEVEL&lt;br&gt;«—» наследует выбранную клавишу&lt;br&gt;Lock действует только на один шаг" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="740" width="440" height="125" /></mxCell><mxCell id="empty" value="&lt;b&gt;EMPTY KIT&lt;/b&gt;&lt;br&gt;Нет назначенных клавиш&lt;br&gt;Нельзя включить ложный триггер&lt;br&gt;Переход в VOICE для назначения" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="740" width="440" height="125" /></mxCell><mxCell id="missing" value="&lt;b&gt;UNASSIGNED / MISSING FILE&lt;/b&gt;&lt;br&gt;Назначение удалено или файл отсутствует&lt;br&gt;Старый шаг сохраняет номер клавиши&lt;br&gt;Автоподстановки соседнего сэмпла нет" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="740" width="440" height="125" /></mxCell><mxCell id="note" value="&lt;b&gt;НОТА — АДРЕС НАЗНАЧЕНИЯ&lt;/b&gt;&lt;br&gt;C3 и D3 с одним asset и одинаковым PITCH воспроизводят одинаковую высоту.&lt;br&gt;Высоту задаёт PITCH назначения; автоматическая хроматическая раскладка — отдельная будущая операция.&lt;br&gt;ONE SHOT проигрывает до END; GATE ограничивает длительность; LOOP повторяет диапазон до конца gate." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="980" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="Назначение 1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="file" target="c3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="Назначение 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="file" target="d3"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="Удержать кнопку + стрелки" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="d3" target="bank"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="bank" target="step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="step" target="lock"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-2" name="03 · Короткие сэмплы и RAM"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="long" value="&lt;b&gt;ДЛИННЫЙ ИСХОДНИК НА SD&lt;/b&gt;&lt;br&gt;Пример: 60 s / 44.1 kHz / PCM16&lt;br&gt;Mono ≈ 5.05 MiB · stereo ≈ 10.09 MiB" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="60" width="440" height="110" /></mxCell><mxCell id="blocks" value="&lt;b&gt;ПОДГОТОВКА БЛОКАМИ&lt;/b&gt;&lt;br&gt;Чтение / декодирование / запись&lt;br&gt;Уменьшенная волновая форма&lt;br&gt;Без полного исходника в RAM" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="60" width="440" height="110" /></mxCell><mxCell id="clips" value="&lt;b&gt;КОРОТКИЕ ASSETS НА SD&lt;/b&gt;&lt;br&gt;Физически отдельные файлы&lt;br&gt;Проверить размер каждого фрагмента&lt;br&gt;Исходный файл сохраняется" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="60" width="440" height="110" /></mxCell><mxCell id="references" value="&lt;b&gt;КАРТЫ КЛАВИШ И ПАТТЕРНЫ&lt;/b&gt;&lt;br&gt;Какие assets потребуются для воспроизведения&lt;br&gt;Несколько назначений одного файла&lt;br&gt;считаются одним asset" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="340" width="440" height="125" /></mxCell><mxCell id="estimate" value="&lt;b&gt;ПРОВЕРИТЬ ПИК ПАМЯТИ&lt;/b&gt;&lt;br&gt;Активный + подготавливаемый набор&lt;br&gt;Звучащие голоса удерживают свои файлы&lt;br&gt;Рабочие буферы и FX учесть отдельно" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="340" width="440" height="125" /></mxCell><mxCell id="cache" value="&lt;b&gt;ПОДГОТОВИТЬ PCM-КЭШ&lt;/b&gt;&lt;br&gt;Прочитать уникальные assets заранее&lt;br&gt;Общий буфер, отдельные позиции голосов&lt;br&gt;Не ждать SD в момент триггера" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="340" width="440" height="125" /></mxCell><mxCell id="over" value="&lt;b&gt;НЕ ПОМЕЩАЕТСЯ&lt;/b&gt;&lt;br&gt;Показать нужный и доступный объём&lt;br&gt;Укоротить / нарезать / сократить набор&lt;br&gt;Либо остановить и загрузить новую сцену" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="610" width="440" height="125" /></mxCell><mxCell id="ready" value="&lt;b&gt;READY → ВОСПРОИЗВЕДЕНИЕ&lt;/b&gt;&lt;br&gt;Шаг выбирает только назначенную KEY&lt;br&gt;Смена сцены ждёт подготовки её assets&lt;br&gt;Не выгружать звучащие данные" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1070" y="610" width="440" height="125" /></mxCell><mxCell id="budget" value="&lt;b&gt;ТЕСТОВЫЙ БЮДЖЕТ UI&lt;/b&gt;&lt;br&gt;Кэш PCM: 8 MiB · asset: до 1 MiB&lt;br&gt;Числа предварительные&lt;br&gt;Проверить реальную RAM и SD на устройстве" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="610" width="440" height="125" /></mxCell><mxCell id="formula" value="&lt;b&gt;РАСЧЁТ И ИНДИКАЦИЯ&lt;/b&gt;&lt;br&gt;RAM PCM = число кадров × каналы × байты на канал. Float32 занимает вдвое больше int16.&lt;br&gt;10 секунд PCM16 / 44.1 kHz: mono ≈ 0.84 MiB, stereo ≈ 1.68 MiB.&lt;br&gt;Показывать SD и RAM отдельно. Подрезка назначения не уменьшает целиком загружаемый asset." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="900" width="1460" height="140" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="long" target="blocks"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="blocks" target="clips"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="references" target="estimate"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="Да" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="estimate" target="cache"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="Превышение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="estimate" target="over"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="cache" target="ready"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>