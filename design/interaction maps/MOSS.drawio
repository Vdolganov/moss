<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="moss-0" name="01 · Карта MOSS"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="atlas" value="&lt;b&gt;ATLAS · проекты&lt;/b&gt;&lt;br&gt;Создать · SLOW SIGNAL · выбрать сохранённый" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="60" width="440" height="80" /></mxCell><mxCell id="project" value="&lt;b&gt;ОТКРЫТЫЙ ПРОЕКТ&lt;/b&gt;&lt;br&gt;Верхние вкладки GRID / MIX / TAPE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="200" width="440" height="80" /></mxCell><mxCell id="grid" value="&lt;b&gt;GRID&lt;/b&gt;&lt;br&gt;Обзор дорожек: имя · VOICE · SPACE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="360" width="440" height="95" /></mxCell><mxCell id="mix" value="&lt;b&gt;MIX&lt;/b&gt;&lt;br&gt;Микшер · глобальные эффекты · сцены" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="360" width="440" height="95" /></mxCell><mxCell id="tape" value="&lt;b&gt;TAPE&lt;/b&gt;&lt;br&gt;Ресэмплинг одной дорожки или MASTER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="360" width="440" height="95" /></mxCell><mxCell id="track" value="&lt;b&gt;ДОРОЖКА&lt;/b&gt;&lt;br&gt;PATTERN / VOICE / SPACE&lt;br&gt;Добавить, назвать, копировать, удалить" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="520" width="440" height="110" /></mxCell><mxCell id="mixparts" value="&lt;b&gt;РАЗДЕЛЫ MIX&lt;/b&gt;&lt;br&gt;LEVELS: level / pan / mute / solo&lt;br&gt;MASTER FX: ORBIT / POND&lt;br&gt;SCENES: 4 снимка состояния" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="520" width="440" height="130" /></mxCell><mxCell id="memory" value="&lt;b&gt;ЗАХВАТ И ПАМЯТЬ&lt;/b&gt;&lt;br&gt;Source / length · capture / finish / cancel&lt;br&gt;Список сэмплов · имя · удаление&lt;br&gt;ASSIGN TO TRACK → SAMPLER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="520" width="440" height="130" /></mxCell><mxCell id="manage" value="&lt;b&gt;УПРАВЛЕНИЕ ПРОЕКТОМ&lt;/b&gt;&lt;br&gt;Имя · BPM · тональность&lt;br&gt;Копия · экспорт JSON · удаление&lt;br&gt;Импорт создаёт отдельный проект" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="60" y="770" width="440" height="125" /></mxCell><mxCell id="persist" value="&lt;b&gt;СОХРАНЕНИЕ И ОТМЕНА&lt;/b&gt;&lt;br&gt;Автосохранение в этом браузере&lt;br&gt;JSON переносит проект с памятью&lt;br&gt;Undo: до 30 изменений в сессии" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="560" y="770" width="440" height="125" /></mxCell><mxCell id="limits" value="&lt;b&gt;ГРАНИЦЫ ПРОТОТИПА&lt;/b&gt;&lt;br&gt;До 8 дорожек · паттерны A–D&lt;br&gt;16 / 64 шага · 4 сцены&lt;br&gt;Нет звука, DSP, микрофона и WAV" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1060" y="770" width="440" height="125" /></mxCell><mxCell id="edge-0" value="Открыть / создать" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="atlas" target="project"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="project" target="grid"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="project" target="mix"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="project" target="tape"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grid" target="track"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mix" target="mixparts"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="tape" target="memory"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-1" name="02 · Внутри дорожки"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="track" value="&lt;b&gt;ДОРОЖКА&lt;/b&gt;&lt;br&gt;Имя · инструмент · собственный SPACE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="45" width="440" height="75" /></mxCell><mxCell id="pattern" value="&lt;b&gt;PATTERN&lt;/b&gt;&lt;br&gt;A–D · длина 16 / 64 · страницы по 16" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="190" width="460" height="85" /></mxCell><mxCell id="voice" value="&lt;b&gt;VOICE&lt;/b&gt;&lt;br&gt;ORGANISM / MONO / SAMPLER" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="190" width="460" height="85" /></mxCell><mxCell id="space" value="&lt;b&gt;SPACE&lt;/b&gt;&lt;br&gt;ORBIT / POND · FX ON / BYPASS" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="190" width="460" height="85" /></mxCell><mxCell id="step" value="&lt;b&gt;STEP · четыре поля&lt;/b&gt;&lt;br&gt;Z: note · X: velocity&lt;br&gt;C: gate · V: probability" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="340" width="460" height="95" /></mxCell><mxCell id="locks" value="&lt;b&gt;LOCKS · те же кнопки&lt;/b&gt;&lt;br&gt;Четыре параметра текущего инструмента&lt;br&gt;«—» наследует базовое значение&lt;br&gt;Первая стрелка назначает lock" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="495" width="460" height="115" /></mxCell><mxCell id="lockroles" value="&lt;b&gt;ПАРАМЕТРЫ LOCKS&lt;/b&gt;&lt;br&gt;ORGANISM: tension / drift / chaos / density&lt;br&gt;MONO: cutoff / resonance / attack / release&lt;br&gt;SAMPLER: pitch / speed / slice / level" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="670" width="460" height="130" /></mxCell><mxCell id="org" value="&lt;b&gt;ORGANISM&lt;/b&gt;&lt;br&gt;Tension / drift / chaos / density&lt;br&gt;Preset · смена инструмента" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="340" width="460" height="95" /></mxCell><mxCell id="mono" value="&lt;b&gt;MONO&lt;/b&gt;&lt;br&gt;Cutoff / resonance / attack / release&lt;br&gt;Preset · смена инструмента" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="495" width="460" height="95" /></mxCell><mxCell id="sampler" value="&lt;b&gt;SAMPLER&lt;/b&gt;&lt;br&gt;Pitch / speed / slices / slice&lt;br&gt;Память сэмплов · reverse · loop" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="650" width="460" height="100" /></mxCell><mxCell id="orbit" value="&lt;b&gt;ORBIT&lt;/b&gt;&lt;br&gt;Time / feedback / mix / spread" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="340" width="460" height="95" /></mxCell><mxCell id="pond" value="&lt;b&gt;POND&lt;/b&gt;&lt;br&gt;Size / decay / damping / mix" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="495" width="460" height="95" /></mxCell><mxCell id="scope" value="&lt;b&gt;ОБЛАСТЬ ДЕЙСТВИЯ&lt;/b&gt;&lt;br&gt;SPACE меняет только эту дорожку&lt;br&gt;MASTER FX расположен в MIX&lt;br&gt;и обрабатывает общую сумму" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="650" width="460" height="115" /></mxCell><mxCell id="caution" value="&lt;b&gt;УТОЧНИТЬ МОДЕЛЬ ПАТТЕРНОВ&lt;/b&gt;&lt;br&gt;Сейчас выбор A–D, копирование паттерна и длина общие для всех дорожек.&lt;br&gt;Кнопки находятся внутри дорожки: область действия необходимо явно показать.&lt;br&gt;После смены инструмента прежние locks остаются, но могут стать невидимыми." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="910" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="track" target="pattern"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="track" target="voice"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="track" target="space"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pattern" target="step"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="Переключить нижнюю вкладку" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="step" target="locks"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="locks" target="lockroles"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="voice" target="org"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="Другой инструмент" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="org" target="mono"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" value="Другой инструмент" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mono" target="sampler"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="space" target="orbit"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-10" value="Смена эффекта" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="orbit" target="pond"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pond" target="scope"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-12" value="Нужны правила смены инструмента" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="lockroles" target="caution"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-2" name="03 · Постоянные роли кнопок"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="root" value="&lt;b&gt;УПРАВЛЕНИЕ MOSS&lt;/b&gt;&lt;br&gt;Объект → раздел → элемент → параметр" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="540" y="40" width="480" height="80" /></mxCell><mxCell id="objects" value="&lt;b&gt;L1 / R1 · Q / E&lt;/b&gt;&lt;br&gt;Предыдущий / следующий объект" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="180" width="460" height="90" /></mxCell><mxCell id="views" value="&lt;b&gt;L2 / R2 · [ / ]&lt;/b&gt;&lt;br&gt;Предыдущая / следующая главная вкладка" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="180" width="460" height="90" /></mxCell><mxCell id="fields" value="&lt;b&gt;A / B / X / Y · Z / X / C / V&lt;/b&gt;&lt;br&gt;Удержать + стрелки: параметр 1 / 2 / 3 / 4" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="180" width="460" height="90" /></mxCell><mxCell id="objectList" value="&lt;b&gt;ОБЪЕКТ ВИДЕН НА ЭКРАНЕ&lt;/b&gt;&lt;br&gt;ATLAS → проект · GRID / редактор → дорожка&lt;br&gt;MIX LEVELS → дорожка · SCENES → сцена&lt;br&gt;TAPE → сэмпл · MASTER FX → неактивно" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="340" width="460" height="130" /></mxCell><mxCell id="viewList" value="&lt;b&gt;ОСНОВНАЯ СТРОКА ВКЛАДОК&lt;/b&gt;&lt;br&gt;В проекте: GRID / MIX / TAPE&lt;br&gt;В дорожке: PATTERN / VOICE / SPACE&lt;br&gt;ATLAS: пара неактивна" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="340" width="460" height="130" /></mxCell><mxCell id="value" value="&lt;b&gt;ЗНАЧЕНИЕ МЕНЯЕТСЯ НА МЕСТЕ&lt;/b&gt;&lt;br&gt;← / → точно · ↑ / ↓ крупно&lt;br&gt;Удержание стрелки ускоряет число&lt;br&gt;Отпустить кнопку → один жест в Undo" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="340" width="460" height="130" /></mxCell><mxCell id="safeSelect" value="&lt;b&gt;ВЫДЕЛИТЬ ≠ ПРИМЕНИТЬ&lt;/b&gt;&lt;br&gt;Выбор сцены не запускает её&lt;br&gt;Выбор проекта не открывает его&lt;br&gt;Выбор сэмпла не назначает его дорожке" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="550" width="460" height="125" /></mxCell><mxCell id="local" value="&lt;b&gt;D-PAD · ЛОКАЛЬНЫЙ ВЫБОР&lt;/b&gt;&lt;br&gt;Шаги, строки, действия, вторичные вкладки&lt;br&gt;Z / A коротко: подтвердить или триггер&lt;br&gt;X / B коротко: назад на один уровень" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="550" width="460" height="125" /></mxCell><mxCell id="cancel" value="&lt;b&gt;SELECT · ОТМЕНА / ATLAS&lt;/b&gt;&lt;br&gt;Во время жеста: отменить весь жест&lt;br&gt;В меню: закрыть без применения&lt;br&gt;В обычном экране: проекты" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="550" width="460" height="125" /></mxCell><mxCell id="retain" value="&lt;b&gt;ПАМЯТЬ ПОЗИЦИИ&lt;/b&gt;&lt;br&gt;Смена дорожки сохраняет VOICE / SPACE&lt;br&gt;Возврат в PATTERN сохраняет шаг и STEP / LOCKS&lt;br&gt;Курки на границе списка не зацикливаются" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="760" width="460" height="130" /></mxCell><mxCell id="shortcuts" value="&lt;b&gt;КОРОТКИЕ КОМАНДЫ&lt;/b&gt;&lt;br&gt;C / X: шаг ↔ нижние поля в PATTERN&lt;br&gt;V / Y: STEP ↔ LOCKS в PATTERN&lt;br&gt;START / Space: воспроизведение / пауза" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="550" y="760" width="460" height="130" /></mxCell><mxCell id="priority" value="&lt;b&gt;ПРИОРИТЕТ ВВОДА&lt;/b&gt;&lt;br&gt;Меню / ввод текста блокируют команды фона&lt;br&gt;Активный жест фиксирует объект и параметр&lt;br&gt;Потеря фокуса прекращает повтор стрелок" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1050" y="760" width="460" height="130" /></mxCell><mxCell id="visual" value="&lt;b&gt;ПОСТОЯННЫЕ ВИЗУАЛЬНЫЕ ОПОЗНАВАТЕЛИ&lt;/b&gt;&lt;br&gt;У параметров: Z шалфей · X голубой · C лаванда · V глина. Курки нейтральные.&lt;br&gt;L1/R1 стоят около имени объекта; L2/R2 — около главных вкладок.&lt;br&gt;При удержании подсвечиваются параметр и кнопка. Недоступные пары явно приглушены." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="970" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="root" target="objects"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="root" target="views"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="root" target="fields"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="objects" target="objectList"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="views" target="viewList"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="fields" target="value"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="objectList" target="safeSelect"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="viewList" target="local"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" value="На устройстве нет Escape" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="value" target="cancel"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="safeSelect" target="retain"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="local" target="shortcuts"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;dashed=1;" edge="1" parent="1" source="cancel" target="priority"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-3" name="04 · Ресэмплинг и возврат"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="source" value="&lt;b&gt;TAPE · SOURCE&lt;/b&gt;&lt;br&gt;Z + стрелки: MASTER или дорожка" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="60" width="420" height="95" /></mxCell><mxCell id="length" value="&lt;b&gt;LENGTH&lt;/b&gt;&lt;br&gt;X + стрелки: 1–8 тактов" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="60" width="420" height="95" /></mxCell><mxCell id="capture" value="&lt;b&gt;CAPTURE&lt;/b&gt;&lt;br&gt;Таймер · прогресс&lt;br&gt;Источник и длина заблокированы" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="60" width="420" height="95" /></mxCell><mxCell id="cancel" value="&lt;b&gt;CANCEL&lt;/b&gt;&lt;br&gt;Закончить без нового сэмпла" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="260" width="420" height="95" /></mxCell><mxCell id="finish" value="&lt;b&gt;FINISH / ИСТЁК ТАЙМЕР&lt;/b&gt;&lt;br&gt;Создать визуальный сэмпл в памяти" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="260" width="420" height="95" /></mxCell><mxCell id="memory" value="&lt;b&gt;SAMPLE MEMORY&lt;/b&gt;&lt;br&gt;Сэмпл выбран · источник и длительность&lt;br&gt;Исходная дорожка сохранена" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="260" width="420" height="110" /></mxCell><mxCell id="assign" value="&lt;b&gt;ASSIGN TO TRACK&lt;/b&gt;&lt;br&gt;Явно выбрать дорожку назначения" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="460" width="420" height="95" /></mxCell><mxCell id="sampler" value="&lt;b&gt;VOICE → SAMPLER&lt;/b&gt;&lt;br&gt;Копия сэмпла назначена&lt;br&gt;Pitch / speed / slices / slice" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="460" width="420" height="95" /></mxCell><mxCell id="persist" value="&lt;b&gt;ПАМЯТЬ ПРОЕКТА&lt;/b&gt;&lt;br&gt;Переименовать · удалить из памяти&lt;br&gt;Назначенные копии остаются&lt;br&gt;Экспорт JSON включает память" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="460" width="420" height="120" /></mxCell><mxCell id="leave" value="&lt;b&gt;ВЫХОД ВО ВРЕМЯ CAPTURE&lt;/b&gt;&lt;br&gt;B / SELECT / вкладки / смена проекта" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="710" width="420" height="100" /></mxCell><mxCell id="choice" value="&lt;b&gt;ПОКАЗАТЬ ВЫБОР&lt;/b&gt;&lt;br&gt;Остаться · закончить и сохранить&lt;br&gt;Отменить захват и выйти" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="710" width="420" height="100" /></mxCell><mxCell id="return" value="&lt;b&gt;ПРОДОЛЖИТЬ ПЕРЕХОД&lt;/b&gt;&lt;br&gt;Только после сохранения или отмены&lt;br&gt;Сэмпл принадлежит исходному проекту" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="710" width="420" height="100" /></mxCell><mxCell id="gap" value="&lt;b&gt;СЕЙЧАС ЕСТЬ РАЗРЫВ СЦЕНАРИЯ&lt;/b&gt;&lt;br&gt;Таймер работает вне TAPE, включая ATLAS; открытие проекта сбрасывает захват.&lt;br&gt;В коде есть projectId захвата, но finishCapture сохраняет через текущий p().&lt;br&gt;Нужны явный выход и привязка результата к проекту; автоматического сохранения аудио нет." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="900" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="source" target="length"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="length" target="capture"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="Отмена" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="capture" target="cancel"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="Сохранить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="capture" target="finish"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="finish" target="memory"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="memory" target="assign"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="assign" target="sampler"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="Хранение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sampler" target="persist"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="leave" target="choice"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="choice" target="return"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-4" name="05 · Сцены и область снимка"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="work" value="&lt;b&gt;ТЕКУЩЕЕ СОСТОЯНИЕ&lt;/b&gt;&lt;br&gt;Паттерны · инструменты · FX · микшер" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="60" width="420" height="95" /></mxCell><mxCell id="save" value="&lt;b&gt;SAVE HERE / OVERWRITE&lt;/b&gt;&lt;br&gt;Один из 4 слотов · имя&lt;br&gt;Перезапись с подтверждением" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="60" width="420" height="95" /></mxCell><mxCell id="snapshot" value="&lt;b&gt;СНИМОК СЦЕНЫ&lt;/b&gt;&lt;br&gt;Все tracks целиком + BPM + master FX&lt;br&gt;Активный паттерн + длина" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="60" width="420" height="110" /></mxCell><mxCell id="select" value="&lt;b&gt;ВЫБРАТЬ СЦЕНУ&lt;/b&gt;&lt;br&gt;Предложение: L1/R1 выделяют слот&lt;br&gt;Применение только по A" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="270" width="420" height="100" /></mxCell><mxCell id="stopped" value="&lt;b&gt;ТРАНСПОРТ ОСТАНОВЛЕН&lt;/b&gt;&lt;br&gt;Применить снимок сразу" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="470" width="420" height="100" /></mxCell><mxCell id="running" value="&lt;b&gt;ТРАНСПОРТ ИДЁТ&lt;/b&gt;&lt;br&gt;Поставить сцену в очередь NEXT LOOP&lt;br&gt;Повторный выбор убирает её из очереди" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="470" width="420" height="100" /></mxCell><mxCell id="restore" value="&lt;b&gt;ВОССТАНОВИТЬ СЦЕНУ&lt;/b&gt;&lt;br&gt;Состав, имена, инструменты, все паттерны&lt;br&gt;Дорожечные FX, уровни и mute / solo&lt;br&gt;BPM, master FX, выбранный паттерн, длина" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="720" width="420" height="135" /></mxCell><mxCell id="boundary" value="&lt;b&gt;НАЧАЛО ЦИКЛА&lt;/b&gt;&lt;br&gt;Применить, если нет жеста / меню&lt;br&gt;Позиция воспроизведения → начало" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="720" width="420" height="135" /></mxCell><mxCell id="memory" value="&lt;b&gt;ЧТО ОСТАЁТСЯ В ПРОЕКТЕ&lt;/b&gt;&lt;br&gt;Память TAPE и настройки capture&lt;br&gt;Название проекта и тональность&lt;br&gt;Сами слоты сцен" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="720" width="420" height="135" /></mxCell><mxCell id="sceneIssue" value="&lt;b&gt;НУЖНО УТОЧНИТЬ: ЧТО ТАКОЕ СЦЕНА&lt;/b&gt;&lt;br&gt;Сейчас сцена может вернуть удалённую дорожку,&lt;br&gt;старое имя или прежние паттерны.&lt;br&gt;Рекомендуется явно выбрать: полный снимок&lt;br&gt;или только вариация звучания." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f2e8e1;strokeColor=#b18d77;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="960" width="700" height="150" /></mxCell><mxCell id="stopIssue" value="&lt;b&gt;НУЖНО УТОЧНИТЬ: STOP ПРИ NEXT LOOP&lt;/b&gt;&lt;br&gt;Сейчас остановка немедленно применяет очередь.&lt;br&gt;Предлагается: STOP отменяет очередь,&lt;br&gt;активная сцена остаётся прежней;&lt;br&gt;применить другую можно отдельным нажатием A." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#edf1e9;strokeColor=#879775;fontColor=#263124;dashed=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="800" y="960" width="710" height="150" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="work" target="save"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="save" target="snapshot"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="A при STOP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="select" target="stopped"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="A при RUN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="select" target="running"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="stopped" target="restore"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="running" target="boundary"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="boundary" target="restore"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="Сохраняются" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="restore" target="memory"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="moss-5" name="06 · SLOW SIGNAL: полный маршрут"><mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="new" value="&lt;b&gt;1 · ПУСТОЙ ПРОЕКТ&lt;/b&gt;&lt;br&gt;ATLAS → NEW PROJECT → SLOW SIGNAL&lt;br&gt;BPM 70 · G MINOR · длина 64" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="60" width="420" height="105" /></mxCell><mxCell id="drone" value="&lt;b&gt;2 · DRONE / ORGANISM&lt;/b&gt;&lt;br&gt;Добавить дорожку · шаг 01 ON&lt;br&gt;Note G2 · gate 64&lt;br&gt;Настроить 4 параметра VOICE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="60" width="420" height="105" /></mxCell><mxCell id="pulse" value="&lt;b&gt;3 · PULSE / MONO&lt;/b&gt;&lt;br&gt;Добавить MONO&lt;br&gt;Шаги 01, 21, 45, 61&lt;br&gt;Редактировать ноты и probability" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="60" width="420" height="105" /></mxCell><mxCell id="locks" value="&lt;b&gt;4 · LOCK НА ШАГЕ 45&lt;/b&gt;&lt;br&gt;PATTERN → шаг 45 → LOCKS&lt;br&gt;Z + стрелки: cutoff 1400&lt;br&gt;Проверить соседний шаг" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="310" width="420" height="105" /></mxCell><mxCell id="fx" value="&lt;b&gt;5 · SPACE И MIX&lt;/b&gt;&lt;br&gt;Эффект PULSE → FX ON&lt;br&gt;MIX: уровни трёх дорожек позже&lt;br&gt;MASTER FX: общий эффект" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="310" width="420" height="105" /></mxCell><mxCell id="capture" value="&lt;b&gt;6 · ЗАХВАТ DRONE&lt;/b&gt;&lt;br&gt;TAPE → Z: DRONE · X: 4 такта&lt;br&gt;CAPTURE → FINISH / таймер&lt;br&gt;Проверить, что DRONE остался ORGANISM" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="310" width="420" height="105" /></mxCell><mxCell id="dust" value="&lt;b&gt;7 · DUST / SAMPLER&lt;/b&gt;&lt;br&gt;Добавить третью дорожку&lt;br&gt;TAPE → ASSIGN TO TRACK → DUST&lt;br&gt;Настроить pitch, speed и слайсы" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="560" width="420" height="115" /></mxCell><mxCell id="texture" value="&lt;b&gt;8 · ПАТТЕРН ТЕКСТУРЫ&lt;/b&gt;&lt;br&gt;Шаги 09, 33, 53: gate 8, probability 65&lt;br&gt;Проверить три дорожки через L1/R1&lt;br&gt;Целевая навигация — пока предложение" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="570" y="560" width="420" height="115" /></mxCell><mxCell id="scenes" value="&lt;b&gt;9 · ДВЕ СЦЕНЫ&lt;/b&gt;&lt;br&gt;MIX → SCENES: сохранить ARRIVAL&lt;br&gt;Изменить VOICE / FX / MIX&lt;br&gt;Сохранить BLOOM; сравнить сцены" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="1090" y="560" width="420" height="115" /></mxCell><mxCell id="reopen" value="&lt;b&gt;10 · СОХРАНИТЬ И ВЕРНУТЬСЯ&lt;/b&gt;&lt;br&gt;Экспортировать JSON · вернуться в ATLAS · открыть проект снова&lt;br&gt;Проверить: 3 дорожки, 64 шага, lock на 45, сэмпл в памяти и две сцены&lt;br&gt;Это сценарий проверки, а не отчёт о прохождении пользователем" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fontFamily=Arial;fontSize=15;fillColor=#f8f9f4;strokeColor=#889486;fontColor=#263124;" vertex="1" parent="1"><mxGeometry as="geometry" x="50" y="870" width="1460" height="130" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="new" target="drone"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="drone" target="pulse"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="pulse" target="locks"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="locks" target="fx"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="fx" target="capture"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="capture" target="dust"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="dust" target="texture"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="texture" target="scenes"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8b9589;fontColor=#4d594c;fontSize=12;labelBackgroundColor=#f4f4ed;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="scenes" target="reopen"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>